VITE_API_URL=http://localhost:3000/api

VITE_BASE_PATH="/"

# TinyMCE Rich Text Editor API Key
VITE_TINYMCE_API_KEY=your_tinymce_api_key_here

# PDF upload limit (megabytes). Must match backend PDF_UPLOAD_MAX_SIZE_MB.
# Used for client-side size validation and "Max XX MB" UI labels.
VITE_PDF_UPLOAD_MAX_SIZE_MB=50

# Default axios request timeout in ms (used for normal API calls).
VITE_API_TIMEOUT_MS=120000

# Axios timeout in ms for PDF upload requests (much longer than the default
# because uploads can take many seconds on slow connections). Should match the
# backend REQUEST_TIMEOUT_MS and nginx proxy_read_timeout.
VITE_UPLOAD_TIMEOUT_MS=600000